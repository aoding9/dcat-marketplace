{
    "name": "aoding9/dcat-marketplace",
    "description": "Dcat扩展市场 (fork of sparkinzy/dcat-marketplace)",
    "type": "library",
    "version": "2.0.2",
    "keywords": ["dcat-admin", "extension"],
    "homepage": "https://github.com/sparkinzy/dcat-marketplace",
    "license": "MIT",
    "authors": [
        {
            "name": "sparkinzy",
            "email": "sparkinzy@163.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "dcat/laravel-admin": "~2.0"
    },
    "replace": {
        "sparkinzy/dcat-extension-client": "self.version",
        "sparkinzy/dcat-marketplace": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Sparkinzy\\DcatMarketPlace\\": "src/"
        }
    },
    "extra": {
        "dcat-admin": "Sparkinzy\\DcatMarketPlace\\DcatMarketplaceServiceProvider",
        "laravel": {
            "providers": [
                "Sparkinzy\\DcatMarketPlace\\DcatMarketplaceServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
